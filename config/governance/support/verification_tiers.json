{
  "schemaVersion": 1,
  "kind": "openclaw_verification_tiers",
  "tiers": [
    {
      "id": "official_release",
      "title": "正式 Docker / 控制面容器门禁",
      "status": "release_required",
      "releaseRequired": true,
      "diagnosticOnly": false,
      "description": "用于提交前、发版前和目标机交付前的正式 release pass；固定要求 Docker daemon 与控制面容器执行介质。",
      "commands": [
        "bash ./scripts/testing/check_repo_test_readiness.sh",
        "bash ./scripts/setup/prepare_control_plane_medium.sh",
        "bash ./scripts/testing/run_repo_unittest.sh",
        "bash ./scripts/doctor/run_repo_release_gate.sh",
        "bash ./scripts/runtime/run_openclaw_python_tool.sh control-plane facts overview --all-profiles --format json --no-local-probe"
      ]
    },
    {
      "id": "host_diagnostic",
      "title": "宿主机静态前置检查",
      "status": "diagnostic_only",
      "releaseRequired": false,
      "diagnosticOnly": true,
      "description": "仅用于正式容器门禁前的只读环境检查；不得执行仓库 Python 或替代正式 Docker / 控制面容器门禁。",
      "commands": [
        "bash ./scripts/testing/check_repo_test_readiness.sh",
        "bash ./scripts/runtime/verify_python_runtime_container.sh --static-only",
        "bash ./scripts/doctor/check_host_python_governance.sh --json"
      ]
    }
  ]
}
