{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://openclaw.local/control-plane/skill_set.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "moduleRef",
    "title",
    "version",
    "ownerDomain",
    "source",
    "governance",
    "derivation"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$",
      "minLength": 3
    },
    "moduleRef": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$",
      "minLength": 3
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^v[0-9]+$"
    },
    "ownerDomain": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "format"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "type": "string",
          "const": "markdown"
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "changeControlDocPaths"
      ],
      "properties": {
        "changeControlDocPaths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "derivation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "moduleManifestPath",
        "assetKey"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "const": "agent_internal"
        },
        "moduleManifestPath": {
          "type": "string",
          "minLength": 1
        },
        "assetKey": {
          "type": "string",
          "const": "skillsPath"
        }
      }
    }
  }
}
