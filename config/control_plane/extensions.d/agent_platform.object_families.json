{
  "schema_version": 1,
  "families": {
    "dispatch_runtime_state": {
      "label": "投递运行态对象族",
      "purpose": "统一说明投递运行摘要、目标注册表、每次运行及重试队列的路径，供平台观测与排障使用。",
      "references": [
        "docs/operations/dispatch-targets.md",
        "docs/operations/troubleshooting.md"
      ],
      "entries": [
        {
          "id": "dispatch_runtime_summary_json",
          "title": "dispatch runtime summary",
          "path_kind": "runtime_path",
          "path_ref": "dispatch_runtime_summary_json",
          "producer": "setup env render-dispatch-runtime / bootstrap",
          "usage": "记录当前目标注册表、provider 绑定、默认目标组与投递运行状态的结构化摘要。"
        },
        {
          "id": "dispatch_targets_json",
          "title": "dispatch targets registry copy",
          "path_kind": "runtime_path",
          "path_ref": "dispatch_targets_json",
          "producer": "setup env render-dispatch-runtime / bootstrap",
          "usage": "scheduler 侧的投递目标快照，供运行执行与排障使用。"
        },
        {
          "id": "dispatch_out_dir",
          "title": "dispatch output directory",
          "path_kind": "runtime_path",
          "path_ref": "dispatch_out_dir",
          "producer": "delivery_adapter / dispatcher",
          "usage": "dispatch.json、status.json、ledger.jsonl、queue 与 queue_done 等投递产物的根目录。"
        },
        {
          "id": "dispatch_runs_dir",
          "title": "dispatch runs directory",
          "path_kind": "runtime_path",
          "path_ref": "dispatch_runs_dir",
          "producer": "delivery_adapter / dispatcher",
          "usage": "按运行分隔的投递输出目录，保存每次运行的审计产物。"
        },
        {
          "id": "dispatch_queue_dir",
          "title": "dispatch queue directory",
          "path_kind": "runtime_path",
          "path_ref": "dispatch_queue_dir",
          "producer": "dispatcher queue manager",
          "usage": "宿主机侧等待重试的投递队列目录。"
        },
        {
          "id": "dispatch_queue_done_dir",
          "title": "dispatch queue_done directory",
          "path_kind": "runtime_path",
          "path_ref": "dispatch_queue_done_dir",
          "producer": "dispatcher queue manager",
          "usage": "已完成、过期或失败的重试队列归档目录。"
        }
      ]
    },
    "dispatch_governance_state": {
      "label": "投递治理审计对象族",
      "purpose": "统一说明平台共享的目标验收、批次验收、轮换顺序、治理检查与生命周期变更审计产物。",
      "references": [
        "docs/operations/dispatch-targets.md",
        "docs/operations/troubleshooting.md"
      ],
      "entries": [
        {
          "id": "dispatch_target_acceptance_audit_dir",
          "title": "target acceptance audit directory",
          "path_kind": "runtime_path",
          "path_ref": "dispatch_target_acceptance_audit_dir",
          "producer": "bash ./scripts/runtime/run_openclaw_python_tool.sh dispatch observability show-target-acceptance --target <target_id> --gate-env-file deploy/.env --write-audit",
          "usage": "按投递目标保存验收结果的默认审计目录。"
        },
        {
          "id": "dispatch_target_batch_acceptance_audit_dir",
          "title": "batch acceptance audit directory",
          "path_kind": "runtime_path",
          "path_ref": "dispatch_target_batch_acceptance_audit_dir",
          "producer": "bash ./scripts/runtime/run_openclaw_python_tool.sh dispatch observability show-batch-acceptance --batch <batch_id> --gate-env-file deploy/.env --write-audit",
          "usage": "按批次保存验收结果与发布门禁结果的默认审计目录。"
        },
        {
          "id": "dispatch_target_rotation_sequence_audit_dir",
          "title": "rotation sequence audit directory",
          "path_kind": "runtime_path",
          "path_ref": "dispatch_target_rotation_sequence_audit_dir",
          "producer": "bash ./scripts/runtime/run_openclaw_python_tool.sh dispatch ops verify-rotation-sequence --gate-env-file deploy/.env --control-plane-profile <profile_id> --write-audit",
          "usage": "保存轮换顺序验证结果的默认审计目录。"
        },
        {
          "id": "dispatch_governance_audit_dir",
          "title": "dispatch governance audit directory",
          "path_kind": "runtime_path",
          "path_ref": "dispatch_governance_audit_dir",
          "producer": "bash ./scripts/runtime/run_openclaw_python_tool.sh dispatch ops verify-rotation-sequence --gate-env-file deploy/.env --control-plane-profile <profile_id> --write-audit",
          "usage": "保存平台级投递治理检查结果的默认审计目录。"
        },
        {
          "id": "dispatch_target_lifecycle_audit_dir",
          "title": "lifecycle audit directory",
          "path_kind": "runtime_path",
          "path_ref": "dispatch_target_lifecycle_audit_dir",
          "producer": "bash ./scripts/setup/update_dispatch_target_lifecycle.sh --write-audit",
          "usage": "保存目标停用与退役等生命周期变更的默认审计目录。"
        }
      ]
    }
  }
}
