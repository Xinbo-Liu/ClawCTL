# OpenClaw deploy/site.env
# 说明：当前交互固定使用私有 HTTPS ingress 单一入口；gateway host/host port 由统一 ingress 合同处理。

OPENCLAW_INGRESS_HSTS_MAX_AGE=300

OPENCLAW_TLS_MODE=self_signed

# 说明: 含义：private ingress 在目标机绑定的唯一私网或 loopback IP。
# 说明: 来源：第 1 步 `init_private_ingress.sh` 通常已回填；只有实际部署网卡不是默认探测地址时才改写。
# 说明: loopback 只在浏览器与目标服务位于同一操作系统实例时允许；跨 OS / 跨网络实例访问场景不属于该例外。
# 说明: 跨 OS / 跨网络实例访问时，填写目标机对访问端可达的私网 IP；不要填写访问端地址、上游网关地址，也不要误写成 loopback。
# 说明: 不要填写：hostname、`0.0.0.0`、`::`、公网地址、访问端地址。
# 说明: 校验：访问端必须能把 `OPENCLAW_TLS_CN` 解析到该地址；compose 渲染结果中的 ingress 80/443 也必须绑定到该地址。若填写 loopback，则浏览器与 curl 验证也必须运行在同一操作系统实例。
# 说明: 建议先确认当前宿主机目标私网 IPv4：
# 命令: hostname -I
# 命令: hostname -I | tr ' ' '\n' | grep -E '^(10\.|172\.(1[6-9]|2[0-9]|3[0-1])\.|192\.168\.)' | head -n 1
OPENCLAW_INGRESS_LISTEN_IP=__REQUIRED__

# 示例: OPENCLAW_TLS_CN=openclaw.internal.example
# 说明: 含义：唯一访问主机名、证书主机名与 Gateway Control UI origin。
# 说明: 来源：第 1 步 `init_private_ingress.sh` 通常已回填；只有主机名策略变化时才改写。
# 说明: 跨 OS / 跨网络实例访问时，访问端 DNS/hosts 必须把该名称解析到目标机 ingress 地址，而不是访问端地址或上游网关地址。
# 说明: 不要填写：目标机 IP、未纳入正式访问计划的域名、IPv4 dotted-quad 形态、通配符、带下划线、空 label 或与证书 SAN 不一致的名称。
# 说明: 校验：访问端 DNS/hosts 必须把该名称解析到 `OPENCLAW_INGRESS_LISTEN_IP`；provided_files 模式下外部证书必须包含精确 dNSName SAN。
OPENCLAW_TLS_CN=__REQUIRED__

# 示例: OPENCLAW_TLS_CERT_SOURCE_PATH=/srv/certs/openclaw.internal.example.crt
# 说明: 含义：provided_files 模式下供 ingress 复制使用的外部证书文件路径。
# 说明: 仅在 `OPENCLAW_TLS_MODE=provided_files` 时填写。
# 说明: 校验：证书必须是未过期 PEM X.509/fullchain，包含精确 `dNSName:OPENCLAW_TLS_CN` SAN，并与 `OPENCLAW_TLS_KEY_SOURCE_PATH` 指向的未加密 PEM 私钥匹配。
# 说明: 约束：文件不得位于或指向 `deploy/nginx/certs/` 输出目录。
OPENCLAW_TLS_CERT_SOURCE_PATH=

# 示例: OPENCLAW_TLS_KEY_SOURCE_PATH=/srv/certs/openclaw.internal.example.key
# 说明: 含义：provided_files 模式下供 ingress 复制使用的外部私钥文件路径。
# 说明: 仅在 `OPENCLAW_TLS_MODE=provided_files` 时填写。
# 说明: 校验：必须是未加密 PEM 私钥，并与 `OPENCLAW_TLS_CERT_SOURCE_PATH` 指向证书的公钥配对成功。
# 说明: 约束：文件不得位于或指向 `deploy/nginx/certs/` 输出目录。
OPENCLAW_TLS_KEY_SOURCE_PATH=

OPENCLAW_INGRESS_BOUNDARY_MODE=host_firewall

# 说明: 含义：允许访问 private ingress 80/443 的来源网段。
# 说明: 获取：填写“目标机最终看到的源地址网段”。直连办公网/堡垒机时，也必须以目标机日志、上游转发记录或抓包看到的来源地址为准；通过 VPN 时，填 VPN 地址池或 VPN 出口 NAT 网段；经上游 ACL/安全组/LB 时，填上游实际放行到目标机的源网段。
# 说明: 目标机本机验收：one_click_deploy 默认会在目标机本机通过 ingress 请求 /healthz 与 /readyz，因此该字段还必须包含 OPENCLAW_INGRESS_LISTEN_IP 对应的本机来源 /32（IPv4）或 /128（IPv6）。
# 说明: 填写原则：按当前确需放行的最小来源面填写；不要为了省事把整个办公私网、宿主机大网段或泛化虚拟交换机网段直接放开。
# 说明: 跨 OS / 跨网络实例访问时，优先填写目标机实际看到的访问端源 IP `/32`；只有虚拟链路、VPN、NAT 或上游代理以网段呈现时才填写对应网段。若网络层把访问端流量翻译成网关地址，则填写该翻译后地址 `/32` 或对应链路网段。
# 说明: 不要填写：Docker/容器网段、公网 CIDR；除本机验收必需的 `OPENCLAW_INGRESS_LISTEN_IP` 精确主机段外，不要把目标机所在大网段当作来源面。
# 说明: 校验：必须与 Nginx 渲染 allowlist、host_firewall 规则或 external_acl 证据中的 `source_cidrs` 归一化后精确一致。
OPENCLAW_INGRESS_ALLOWED_SOURCE_CIDRS=__REQUIRED__

# 说明: 含义：external_acl 模式下的结构化 JSON 证据文件路径。
# 说明: 仅在 `OPENCLAW_INGRESS_BOUNDARY_MODE=external_acl` 时填写。
# 说明: 校验：文件至少必须提供 `schema_version`、`generated_at`、`source_cidrs`、`allowed_ports`、`default_deny`、`ip_families`、`enforcement_plane`，并且至少提供 `target_bind_ip` 或 `target_hostnames` 之一，用来证明与当前部署输入一致。
OPENCLAW_INGRESS_BOUNDARY_EVIDENCE_PATH=

CONTAINER_TZ=Asia/Shanghai

# 示例: OPENCLAW_CONTROL_PLANE_PROFILE=agent_platform
# 示例: OPENCLAW_CONTROL_PLANE_PROFILE=<extension-profile-id>
# 示例: OPENCLAW_CONTROL_PLANE_PROFILE=<combination-profile-id>
# 说明: 含义：选择当前部署启用的 control-plane service profile；人工只填写 profile id，不填写 JSON 文件路径。
# 说明: 来源：支持值来自 config/control_plane/profile_registry.tsv 与有效扩展 profile。
# 说明: 生成：one_click_config 会自动映射生成 OPENCLAW_CONTROL_PLANE_SERVICE_CONFIG_PATH，并按该 profile 装载扩展 deploy env schema、扩展内部 agent/extensions/<extension-id>/deploy/extension.env、dispatch target registry 与模型输入。
OPENCLAW_CONTROL_PLANE_PROFILE=agent_platform

OPENCLAW_RUNTIME_UID=

OPENCLAW_RUNTIME_GID=
