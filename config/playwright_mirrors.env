# Playwright 浏览器下载源（按优先级从高到低）
#
# 说明：
# - 镜像准备流程 会按顺序依次尝试这些候选源。
# - 某个源构建成功后立即停止；若失败则自动回退到下一个。
# - 留空表示回退到 Playwright 官方默认源（Microsoft CDN）。
# - 如你有企业内网制品库，可把它插到最前面。

# 1) npmmirror 新 CDN（通常更快，且 cnpm/binary-mirror-config 已使用该地址）
MIRROR_1_NAME="npmmirror-cdn"
MIRROR_1_PLAYWRIGHT_DOWNLOAD_HOST="https://cdn.npmmirror.com/binaries/playwright"
MIRROR_1_PLAYWRIGHT_CHROMIUM_DOWNLOAD_HOST="https://cdn.npmmirror.com/binaries/chrome-for-testing"

# 2) npmmirror 备用路径（部分网络环境下对该域名命中更好）
MIRROR_2_NAME="npmmirror-alt"
MIRROR_2_PLAYWRIGHT_DOWNLOAD_HOST="https://npmmirror.com/mirrors/playwright"
MIRROR_2_PLAYWRIGHT_CHROMIUM_DOWNLOAD_HOST="https://npmmirror.com/mirrors/chrome-for-testing"

# 3) 官方默认源（最后兜底）
MIRROR_3_NAME="official-default"
MIRROR_3_PLAYWRIGHT_DOWNLOAD_HOST=""
MIRROR_3_PLAYWRIGHT_CHROMIUM_DOWNLOAD_HOST=""
