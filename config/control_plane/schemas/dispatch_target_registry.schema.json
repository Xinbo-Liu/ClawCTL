    "biz_brief",
    "ops_detail",
    "test_detail"
  ],
  "allowedDispatchLanes": [
    "formal_broadcast",
    "operations_monitoring",
    "integration_validation"
  ],
  "allowedPayloadScopes": [
    "business_digest",
    "ops_summary",
    "validation_digest"
  ],
  "allowedMessageFormats": [
    "text",
    "post",
    "card"
  ],
  "allowedReleaseLevels": [
    "official",
    "review",
    "degraded"
