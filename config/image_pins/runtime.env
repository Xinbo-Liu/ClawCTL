# 运行时与控制面镜像默认 pin 的单一真源。
# 说明：
# - host 控制面镜像与运行时 Python 镜像已分离治理；不得再合并为单一变量；
# - Python / Nginx 相关镜像统一固定为 tag@digest；
# - canonical source / acceleration source 统一看 config/runtime/source_strategy.json；本文件只保存当前 selected runtime pin；
# - *_TAG 与 *_DIGEST 仅作为与完整镜像引用保持一致的拆分字段，不允许独立漂移；
# - 仓库默认值提升前必须完成目标机候选验证。
OPENCLAW_CONTROL_PLANE_IMAGE=docker.m.daocloud.io/library/python:3.11.15-slim-bookworm@sha256:9c6f90801e6b68e772b7c0ca74260cbf7af9f320acec894e26fccdaccfbe3b47
OPENCLAW_CONTROL_PLANE_IMAGE_TAG=3.11.15-slim-bookworm
OPENCLAW_CONTROL_PLANE_IMAGE_DIGEST=sha256:9c6f90801e6b68e772b7c0ca74260cbf7af9f320acec894e26fccdaccfbe3b47

OPENCLAW_RUNTIME_PYTHON_IMAGE=docker.m.daocloud.io/library/python:3.11.15-slim-bookworm@sha256:9c6f90801e6b68e772b7c0ca74260cbf7af9f320acec894e26fccdaccfbe3b47
OPENCLAW_RUNTIME_PYTHON_IMAGE_TAG=3.11.15-slim-bookworm
OPENCLAW_RUNTIME_PYTHON_IMAGE_DIGEST=sha256:9c6f90801e6b68e772b7c0ca74260cbf7af9f320acec894e26fccdaccfbe3b47

NGINX_IMAGE=docker.m.daocloud.io/library/nginx:1.28.3-alpine-slim@sha256:b33eedfdf089be1f83759ced27b4deec5b6f1b6fc2a6819ebce0ae351a4406e5
