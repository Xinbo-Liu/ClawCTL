    "id",
    "transport",
    "provider",
    "targetGroup",
    "deliveryTier",
    "messageProfile",
    "enabledDefault",
    "enabledEnv",
    "endpointEnv",
    "secretEnv",
    "titleEnv",
    "atAllEnv",
    "formatEnv",
    "silenceEnabledDefault",
    "silenceEnabledEnv",
    "silenceMinDeltaDefault",
    "silenceMinDeltaEnv",
    "allowedReleaseLevelsDefault",
    "allowedReleaseLevelsEnv",
    "formatDefault",
    "secretRequiredDefault",
    "endpointIsolationDefault",
    "titleDefault",
    "boundary",
    "atAllDefault",
    "verificationOrderDefault",
    "owner",
    "releasePolicyId",
    "verificationBatchIds",
    "lifecycleState",
    "rotationClass"
