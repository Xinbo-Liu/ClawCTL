{
  "schemaVersion": 1,
  "minimumRegistryVersion": 7,
  "topLevelRequired": [
    "version",
    "defaults",
    "releasePolicies",
    "verificationBatches",
    "lifecycleStates",
    "targets"
  ],
  "defaultsRequired": [
    "dedupeWindowHours",
    "maxAttempts",
    "backoffSeconds",
    "targetMinIntervalMs",
    "targetMaxPerSecond",
    "targetMaxPerMinute",
    "targetRateLimitStateTtlSeconds"
  ],
  "allowedTargetGroups": [
    "biz",
    "ops",
    "test"
  ],
  "allowedDeliveryTiers": [
    "business",
    "technical",
    "validation"
