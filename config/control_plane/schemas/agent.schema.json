{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://openclaw.local/control-plane/agent.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "entrypoint",
    "description",
    "capabilities",
    "allowedExecutorKinds",
    "governance"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$",
      "minLength": 3
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "entrypoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "python_cli",
            "shell",
            "openclaw_runtime",
            "delivery_adapter"
          ]
        }
      }
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "network",
        "filesystemWrite",
        "modelRequired",
        "externalDispatch"
      ],
      "properties": {
        "network": {
          "type": "boolean"
        },
        "filesystemWrite": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "modelRequired": {
          "type": "boolean"
        },
        "externalDispatch": {
          "type": "boolean"
        }
      }
    },
    "allowedExecutorKinds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "python_cli",
          "shell",
          "openclaw_runtime",
          "delivery_adapter"
        ]
      }
    },
    "defaultModelProfileRef": {
      "type": "string",
      "minLength": 1
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "moduleRef"
      ],
      "properties": {
        "moduleRef": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$",
          "minLength": 3
        }
      }
    }
  }
}
