{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://openclaw.local/control-plane/job.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "activation",
    "schedule",
    "artifactPolicy"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$",
      "minLength": 3
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabledExtensionIds"
      ],
      "properties": {
        "enabledExtensionIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "enabled": {
      "type": "boolean"
    },
    "order": {
      "type": "integer",
      "minimum": 1
    },
    "agentRef": {
      "type": "string",
      "minLength": 1
    },
    "modelProfileRef": {
      "type": "string",
      "minLength": 1
    },
    "targetBindingRef": {
      "type": "string",
      "minLength": 1
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expr"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "const": "cron"
        },
        "expr": {
          "type": "string",
          "minLength": 9
        },
        "tz": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "concurrencyPolicy": {
      "type": "string",
      "enum": [
        "forbid"
      ]
    },
    "timeoutSeconds": {
      "type": "integer",
      "minimum": 1
    },
    "retryPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "maxAttempts",
        "backoffSeconds"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "maxAttempts": {
          "type": "integer",
          "minimum": 0
        },
        "backoffSeconds": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "dependsOn": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "jobId",
              "requiredStatuses",
              "maxAgeMinutes"
            ],
            "properties": {
              "jobId": {
                "type": "string",
                "minLength": 1
              },
              "requiredStatuses": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "maxAgeMinutes": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        ]
      }
    },
    "artifactPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "latestAlias"
      ],
      "properties": {
        "runArtifactRoot": {
          "type": "string",
          "minLength": 1
        },
        "latestAlias": {
          "type": "string",
          "minLength": 1
        },
        "retentionDays": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "idempotencyKeyPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "scope"
      ],
      "properties": {
        "strategy": {
          "type": "string",
          "enum": [
            "job_schedule_slot",
            "manual_trigger"
          ]
        },
        "scope": {
          "type": "string",
          "enum": [
            "job_id",
            "job_id_plus_target"
          ]
        }
      }
    },
    "failureClassPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retryableClasses",
        "terminalClasses"
      ],
      "properties": {
        "retryableClasses": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "terminalClasses": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "groupRef": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$",
      "minLength": 3
    },
    "runnerRef": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$",
      "minLength": 3
    },
    "operationRef": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$",
      "minLength": 3
    }
  }
}
