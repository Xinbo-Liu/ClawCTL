    "ops": {
      "dispatchLane": "operations_monitoring",
      "allowedDeliveryTiers": [
        "technical"
      ],
      "allowedMessageProfiles": [
        "ops_detail"
      ],
      "allowedPayloadScopes": [
        "ops_summary"
      ],
      "publishLatestDefault": false
    },
    "test": {
      "dispatchLane": "integration_validation",
      "allowedDeliveryTiers": [
        "validation"
      ],
      "allowedMessageProfiles": [
        "test_detail"
      ],
      "allowedPayloadScopes": [
        "validation_digest"
      ],
      "publishLatestDefault": false
    }
  },
  "requiredOwnerFields": [
    "team",
    "primary",
    "backup"
  ],
  "requiredLifecycleFields": [
    "id",
    "title",
    "description",
    "enableAllowed",
    "decommissioned"
