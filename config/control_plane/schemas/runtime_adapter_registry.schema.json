{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://openclaw.local/control-plane/runtime_adapter_registry.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "adapters"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "adapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "description",
          "module",
          "configValidator",
          "runner",
          "supportedEntrypointKinds",
          "supportedExecutorKinds"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$",
            "minLength": 3
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "module": {
            "type": "string",
            "minLength": 1
          },
          "configValidator": {
            "type": "string",
            "minLength": 1
          },
          "runner": {
            "type": "string",
            "minLength": 1
          },
          "supportedEntrypointKinds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "python_cli",
                "shell",
                "openclaw_runtime",
                "delivery_adapter"
              ]
            }
          },
          "supportedExecutorKinds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "python_cli",
                "shell",
                "openclaw_runtime",
                "delivery_adapter"
              ]
            }
          }
        }
      }
    }
  }
}
