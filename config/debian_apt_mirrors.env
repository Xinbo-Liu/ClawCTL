# Debian APT 软件源（按优先级从高到低）
#
# 说明：
# - 镜像准备流程 会按顺序依次尝试这些候选源。
# - 仅用于构建期 Playwright 的 --with-deps 阶段（apt update / apt install）。
# - 留空表示使用 Debian 官方默认源。
# - 如你有企业内网 Debian 制品库，可把它插到最前面。
#
# 约定：
# - *_PRIMARY：主软件源（对应 deb.debian.org/debian）
# - *_SECURITY：安全更新源（对应 security.debian.org/debian-security 或 deb.debian.org/debian-security）

# 1) USTC（容器场景常见，Bookworm/DEB822 说明较明确）
APT_MIRROR_1_NAME="ustc"
APT_MIRROR_1_PRIMARY="https://mirrors.ustc.edu.cn/debian"
APT_MIRROR_1_SECURITY="https://mirrors.ustc.edu.cn/debian-security"

# 2) TUNA（通常较稳；如更看重安全更新实时性，可改回官方 security）
APT_MIRROR_2_NAME="tuna"
APT_MIRROR_2_PRIMARY="https://mirrors.tuna.tsinghua.edu.cn/debian"
APT_MIRROR_2_SECURITY="https://mirrors.tuna.tsinghua.edu.cn/debian-security"

# 3) 官方默认源（最后兜底）
APT_MIRROR_3_NAME="official-default"
APT_MIRROR_3_PRIMARY=""
APT_MIRROR_3_SECURITY=""
